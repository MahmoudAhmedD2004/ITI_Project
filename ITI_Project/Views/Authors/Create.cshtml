@model ITI_Project.ModelView.AuthorViewModel

@{
    ViewData["Title"] = "Create Author";
}

<div style="padding: 24px; max-width: 550px; margin: 0 auto;">
    <h2 style="font-family: 'Fraunces', serif; font-size: 24px; margin-bottom: 20px; color: #111;">Create New Author</h2>

    <form asp-action="Create" method="post" enctype="multipart/form-data" style="background: #fff; padding: 24px; border-radius: 12px; border: 1px solid #e5e5e5;">
        @Html.AntiForgeryToken()

        <div style="margin-bottom: 16px;">
            <label asp-for="Name" style="display: block; margin-bottom: 6px; font-weight: 500; font-size: 14px; color: #333;">Author Name</label>
            <input asp-for="Name" style="width: 100%; padding: 10px 12px; border: 1px solid #ccc; border-radius: 6px; font-size: 14px;" placeholder="e.g. Agatha Christie" required />
            <span asp-validation-for="Name" style="color: #dc2626; font-size: 12px;"></span>
        </div>

        <div style="margin-bottom: 16px;">
            <label asp-for="Bio" style="display: block; margin-bottom: 6px; font-weight: 500; font-size: 14px; color: #333;">Biography</label>
            <textarea asp-for="Bio" rows="4" style="width: 100%; padding: 10px 12px; border: 1px solid #ccc; border-radius: 6px; font-size: 14px;" placeholder="Write brief bio..."></textarea>
        </div>

        <div style="margin-bottom: 24px;">
            <label asp-for="Photo" style="display: block; margin-bottom: 6px; font-weight: 500; font-size: 14px; color: #333;">Author Photo</label>
            <input asp-for="Photo" type="file" accept="image/*" style="width: 100%; font-size: 13px;" />
        </div>

        <div style="display: flex; gap: 10px; justify-content: flex-end;">
            <a asp-action="Index" style="padding: 9px 16px; border: 1px solid #ccc; border-radius: 6px; text-decoration: none; color: #333; font-size: 14px;">Cancel</a>
            <button type="submit" style="padding: 9px 16px; background: #111; color: #fff; border: none; border-radius: 6px; cursor: pointer; font-size: 14px;">Save Author</button>
        </div>
    </form>
</div>