@model ITI_Project.Model.Author
@{
    ViewData["Title"] = "Delete Author";
}

<div style="padding: 24px; max-width: 480px;">
    <h1 style="font-family: 'Fraunces', serif; font-size: 24px; margin: 0 0 8px 0; color: #111;">Delete Author</h1>
    <p style="color: #666; font-size: 14px;">
        Are you sure you want to delete this author? This action cannot be undone, and any books linked to them may be affected.
    </p>

    <div style="background:#fff; border:1px solid #e5e5e5; border-radius:12px; padding:16px; margin: 16px 0; display:flex; gap:12px; align-items:center;">
        <img src="@(string.IsNullOrEmpty(Model.Photo) ? "https://via.placeholder.com/60" : (Model.Photo.StartsWith("/") ? Model.Photo : "/" + Model.Photo))"
             alt="@Model.Name"
             style="width:60px; height:60px; border-radius:50%; object-fit:cover;"
             onerror="this.onerror=null; this.src='https://via.placeholder.com/60';" />
        <strong style="font-size: 16px;">@Model.Name</strong>
    </div>

    <form asp-action="Delete" asp-controller="Authors" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" style="padding: 8px 16px; background: #dc2626; color: #fff; border: none; border-radius: 6px; cursor: pointer;">
            Yes, delete this author
        </button>
        <a asp-action="Index" asp-controller="Authors" style="padding: 8px 16px; color: #333; text-decoration: none;">
            Cancel
        </a>
    </form>
</div>