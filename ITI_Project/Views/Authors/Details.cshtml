@model ITI_Project.ModelView.AuthorDetailsViewModel

@{
    ViewData["Title"] = Model.Author.Name + " - Details";
}

<div style="padding: 24px; max-width: 800px; margin: 0 auto;">
    <a asp-action="Index" style="text-decoration: none; color: #666; font-size: 14px; display: inline-block; margin-bottom: 20px;">← Back to Authors</a>

    <!-- Author Profile Header -->
    <div style="background: #fff; padding: 24px; border-radius: 12px; border: 1px solid #e5e5e5; display: flex; gap: 20px; align-items: center; margin-bottom: 24px;">
        <img src="@(string.IsNullOrEmpty(Model.Author.Photo) ? "https://via.placeholder.com/100" : Model.Author.Photo)"
             style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 1px solid #eee;" />
        <div>
            <h1 style="font-family: 'Fraunces', serif; font-size: 26px; margin: 0 0 8px 0; color: #111;">@Model.Author.Name</h1>
            <p style="color: #666; margin: 0; line-height: 1.5; font-size: 15px;">@(string.IsNullOrEmpty(Model.Author.Bio) ? "No biography available for this author." : Model.Author.Bio)</p>
        </div>
    </div>

    <!-- Books List -->
    <h3 style="font-size: 18px; font-weight: 600; margin-bottom: 16px; color: #111;">Published Books (@Model.Books.Count())</h3>

    @if (!Model.Books.Any())
    {
        <p style="color: #888; font-style: italic;">No books available for this author yet.</p>
    }
    else
    {
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px;">
            @foreach (var book in Model.Books)
            {
                <div style="background: #fff; padding: 16px; border-radius: 8px; border: 1px solid #e5e5e5;">
                    <h4 style="font-size: 15px; margin: 0 0 6px 0; font-weight: 600;">@book.Title</h4>
                    <span style="background: #f4f4f5; padding: 4px 8px; border-radius: 4px; font-size: 12px; color: #555;">@book.Category?.Name</span>
                </div>
            }
        </div>
    }
</div>