@model ITI_Project.Model.Book
@{
    ViewData["Title"] = "Delete Book";
    Layout = "_MyLayout";
}

<h2>Delete Book</h2>
<p>Are you sure you want to delete this book? This action cannot be undone.</p>

<div class="delete-preview">
    <h4>@Model.Title</h4>
    <p><strong>Author:</strong> @Model.Author?.Name</p>
    <p><strong>Category:</strong> @Model.Category?.Name</p>
    <p><strong>Published:</strong> @Model.PublishedYear</p>
</div>

<form asp-action="Delete" asp-controller="Book" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Yes, delete this book</button>
    <a asp-action="Details" asp-controller="Book" asp-route-id="@Model.Id" class="btn btn-ghost">Cancel</a>
</form>