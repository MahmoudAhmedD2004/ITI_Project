@model ITI_Project.Model.Category
@{
    ViewData["Title"] = "Delete Category";
}

<div class="py-4" style="max-width:480px;">
    <h2 class="h4">Delete Category</h2>
    <p>Are you sure you want to delete <strong>@Model.Name</strong>? It currently has @(Model.Books?.Count ?? 0) book(s) linked to it.</p>

    <form asp-action="Delete" asp-controller="Categories" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger">Yes, delete this category</button>
        <a asp-action="Index" asp-controller="Categories" class="btn btn-link">Cancel</a>
    </form>
</div>