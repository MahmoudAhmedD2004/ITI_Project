@model IEnumerable<ITI_Project.Model.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center py-4">
    <div class="d-block mb-4 mb-md-0">
        <h2 class="h4">Categories</h2>
        <p class="mb-0"></p>
        <br />
    </div>
</div>

<form asp-action="Index" method="get" class="filters-bar">
    <div class="filter-group" style="flex:1; min-width:220px;">
        <label>Search</label>
        <input type="text" name="q" value="@ViewBag.Search" placeholder="Search by name or description..." class="form-control" />
    </div>
    <div class="filter-group sort-group">
        <label>Sort by</label>
        <select name="sortBy" onchange="this.form.submit()">
            <option value="name_asc" selected="@(ViewBag.SortBy == "name_asc")">Name (A-Z)</option>
            <option value="name_desc" selected="@(ViewBag.SortBy == "name_desc")">Name (Z-A)</option>
            <option value="books_desc" selected="@(ViewBag.SortBy == "books_desc")">Most books</option>
            <option value="books_asc" selected="@(ViewBag.SortBy == "books_asc")">Fewest books</option>
        </select>
        <button type="submit" class="btn btn-oak btn-sm">Apply</button>
        <a asp-action="Index" class="btn btn-ghost btn-sm">Reset</a>
    </div>
</form>

<div class="card card-body border-0 shadow table-wrapper table-responsive">
    <table class="table table-hover align-items-center">
        <thead>
            <tr>
                <th class="border-gray-200">#</th>
                <th class="border-gray-200">Name's Category</th>
                <th class="border-gray-200">Numbers of Books</th>
                @if (@User.IsInRole("Librarian") || @User.IsInRole("Admin"))
                {
                    <th class="border-gray-200">Actions</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><span class="fw-bold">@item.Id</span></td>
                    <td><span class="fw-normal">@item.Name</span></td>
                    <td><span class="badge bg-secondary">@(item.Books?.Count ?? 0) Book</span></td>
                    @if (@User.IsInRole("Librarian") || @User.IsInRole("Admin"))
                    {
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-link text-primary m-0 p-0">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-link text-danger m-0 p-0">Delete</a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
    @if ((int)ViewBag.TotalPages > 1)
    {
        <nav style="margin-top: 24px; display:flex; gap:6px; justify-content:center; flex-wrap: wrap;">
            @for (int p = 1; p <= (int)ViewBag.TotalPages; p++)
            {
                <a asp-action="Index"
                   asp-route-page="@p"
                   asp-route-q="@ViewBag.Search"
                   asp-route-sortBy="@ViewBag.SortBy"
                   class="btn btn-sm @(p == (int)ViewBag.CurrentPage ? "btn-oak" : "btn-ghost")">
                    @p
                </a>
            }
        </nav>
    }
</div>
</div>
@if (@User.IsInRole("Librarian") || @User.IsInRole("Admin"))
{
    <!-- Modal الإضافة -->
    <div class="modal fade" id="createCategoryModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="Create" method="post">
                    @* @Html.AntiForgeryToken() *@
                    <div class="modal-header">
                        <h5 class="modal-title">Add New Category </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Name's Category </label>
                            <input name="Name" class="form-control" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-link text-gray-600 me-auto" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-secondary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}