@{
    ViewData["Title"] = "All Fines";
    Layout = "_MyLayout";
    var savedFines = ViewBag.SavedFines as List<ITI_Project.Model.Fine> ?? new();
    var overdueLoans = ViewBag.OverdueLoans as List<ITI_Project.Model.Loan> ?? new();
}

<h2>All Fines</h2>

<form asp-action="AllFines" method="get" class="filters-bar">
    <div class="filter-group" style="flex:1; min-width:220px;">
        <label>Search</label>
<div class="parent-input-box-search">
            <i class="bi bi-search icon-box-search"></i>
            <input type="text" name="q" value="@ViewBag.Search" placeholder="Search by member or book..." class="input-box-search" />
        </div>    </div>
    <div class="filter-group">
        <label>Status</label>
        <select name="paid" onchange="this.form.submit()">
            <option value="">All</option>
            <option value="false" selected="@(ViewBag.PaidFilter == false)">Unpaid</option>
            <option value="true" selected="@(ViewBag.PaidFilter == true)">Paid</option>
        </select>
    </div>
    <div class="filter-group sort-group">
        <label>Sort by</label>
        <select name="sortBy" onchange="this.form.submit()">
            <option value="date_desc" selected="@(ViewBag.SortBy == "date_desc")">Newest first</option>
            <option value="date_asc" selected="@(ViewBag.SortBy == "date_asc")">Oldest first</option>
            <option value="amount_desc" selected="@(ViewBag.SortBy == "amount_desc")">Amount (highest)</option>
            <option value="amount_asc" selected="@(ViewBag.SortBy == "amount_asc")">Amount (lowest)</option>
        </select>
        <button type="submit" class="btn btn-oak btn-sm">Apply</button>
        <a asp-action="AllFines" class="btn btn-ghost btn-sm">Reset</a>
    </div>
</form>
<p class="text-muted" style="margin-top:-8px;">Filters apply to the recorded fines table below. Overdue loans without a recorded fine are always shown above unless "Paid" is selected.</p>

<h3 style="margin-top: 24px;">Calculated (Not Yet Settled)</h3>
<p class="text-muted">These are active loans that are overdue. Fines are automatically recorded when the book is returned.</p>

@if (overdueLoans.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Member</th>
                <th>Book</th>
                <th>Due Date</th>
                <th>Days Overdue</th>
                <th>Calculated Fine (5 EGP/day)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var loan in overdueLoans)
            {
                var daysLate = (DateTime.Now.Date - loan.DueDate!.Value.Date).Days;
                var fineAmount = daysLate * 5m;

                <tr class="table-warning">
                    <td>
                        <strong>@loan.Member?.UserName</strong>
                        @if (loan.Member?.IsBlocked == true)
                        {
                            <span class="badge bg-danger">Blocked</span>
                        }
                    </td>
                    <td>@loan.BookCopy?.Book?.Title</td>
                    <td>@loan.DueDate?.ToString("yyyy-MM-dd")</td>
                    <td>@daysLate days</td>
                    <td><strong>@fineAmount.ToString("0.00") EGP</strong> (Current)</td>
                    <td>
                        <a asp-controller="Members" asp-action="Details" asp-route-id="@loan.MemberId"
                           class="view-loans-res">
                            View Member
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No overdue loans without recorded fines.</p>
}

<h3 style="margin-top: 32px;">Recorded Fines (Paid & Unpaid)</h3>

@if (savedFines.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Member</th>
                <th>Book</th>
                <th>Amount</th>
                <th>Created</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var fine in savedFines)
            {
                <tr class="@(fine.IsPaid ? "" : "table-danger")">
                    <td>
                        <strong>@fine.Loan?.Member?.UserName</strong>
                        @if (fine.Loan?.Member?.IsBlocked == true)
                        {
                            <span class="badge bg-dark">Blocked</span>
                        }
                    </td>
                    <td>@fine.Loan?.BookCopy?.Book?.Title</td>
                    <td><strong>@fine.Amount.ToString("0.00") EGP</strong></td>
                    <td>@fine.CreatedDate.ToString("yyyy-MM-dd")</td>
                    <td>@(fine.IsPaid ? "Paid" : "Unpaid")</td>
                    <td>
                        @if (!fine.IsPaid)
                        {
                            <form asp-action="MarkFinePaid" asp-controller="Loan" method="post"
                                  onsubmit="return confirm('Mark this fine as paid?');">
                                <input type="hidden" name="fineId" value="@fine.Id" />
                                <button type="submit" class="btn btn-sm btn-success">Mark Paid</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No recorded fines yet.</p>
}