@model List<ITI_Project.Model.Loan>
@{
    ViewData["Title"] = "All Loans";
    Layout = "_MyLayout";
}

<h2>All Loans</h2>

<form asp-action="AllLoans" method="get" class="filters-bar">
    <div class="filter-group" style="flex:1; min-width:220px;">
        <label>Search</label>
<div class="parent-input-box-search">
            <i class="bi bi-search icon-box-search"></i>
            <input type="text" name="q" value="@ViewBag.Search" placeholder="Search by member or book..." class="input-box-search" />
        </div>    </div>
    <div class="filter-group">
        <label>Status</label>
        <select name="status" onchange="this.form.submit()">
            <option value="">All statuses</option>
            @foreach (var s in Enum.GetValues(typeof(ITI_Project.Model.LoanStatus)))
            {
                <option value="@s" selected="@(ViewBag.StatusFilter?.ToString() == s.ToString())">@s</option>
            }
        </select>
    </div>
    <div class="filter-group sort-group">
        <label>Sort by</label>
        <select name="sortBy" onchange="this.form.submit()">
            <option value="date_desc" selected="@(ViewBag.SortBy == "date_desc")">Requested (newest)</option>
            <option value="date_asc" selected="@(ViewBag.SortBy == "date_asc")">Requested (oldest)</option>
            <option value="due_desc" selected="@(ViewBag.SortBy == "due_desc")">Due date (latest)</option>
            <option value="due_asc" selected="@(ViewBag.SortBy == "due_asc")">Due date (earliest)</option>
        </select>
        <button type="submit" class="btn btn-oak btn-sm">Apply</button>
        <a asp-action="AllLoans" class="btn btn-ghost btn-sm">Reset</a>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Member</th>
            <th>Book</th>
            <th>Status</th>
            <th>Requested</th>
            <th>Due Date</th>
            <th>Returned</th>
            <th>Fine</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var loan in Model)
        {
            <tr>
                <td>@loan.Member?.UserName</td>
                <td>@loan.BookCopy?.Book?.Title</td>
                <td>@loan.Status</td>
                <td>@loan.RequestDate.ToString("yyyy-MM-dd")</td>
                <td>@(loan.DueDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                <td>@(loan.ReturnDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                <td>
                    @{
                        decimal fineAmount = 0;

                        if (loan.Fines != null)
                        {
                            fineAmount = loan.Fines.Amount;
                            <text>@fineAmount.ToString("0.00") EGP @(loan.Fines.IsPaid ? "(Paid)" : "(Unpaid)")</text>
                        }
                        else if ((loan.Status == ITI_Project.Model.LoanStatus.Active ||
                                 loan.Status == ITI_Project.Model.LoanStatus.ReturnRequested) &&
                                 loan.DueDate.HasValue &&
                                 DateTime.Now.Date > loan.DueDate.Value.Date)
                        {
                            var daysLate = (DateTime.Now.Date - loan.DueDate.Value.Date).Days;
                            fineAmount = daysLate * 5;
                            <text>@fineAmount.ToString("0.00") EGP (Current)</text>
                        }
                        else if (fineAmount == 0)
                        {
                            <text>-</text>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if ((int)ViewBag.TotalPages > 1)
{
    <nav style="display:flex; gap:4px; margin-top:12px;">
        @for (int p = 1; p <= (int)ViewBag.TotalPages; p++)
        {
            <a asp-action="AllLoans" asp-route-page="@p"
               asp-route-q="@ViewBag.Search"
               asp-route-status="@ViewBag.StatusFilter"
               asp-route-sortBy="@ViewBag.SortBy"
               class="btn btn-sm @(p == (int)ViewBag.CurrentPage ? "btn-oak" : "btn-ghost")">
                @p
            </a>
        }
    </nav>
}

<a asp-action="PendingRequests" class="btn btn-link">Back</a>