@model List<ITI_Project.Model.Loan>
@{
    ViewData["Title"] = "My Loans";
    Layout = "_MyLayout";
}

<h2>My Loans</h2>

@{
    var totalUnpaid = Model.Where(l => l.Fines != null && !l.Fines.IsPaid).Sum(l => l.Fines!.Amount);
}

@if (totalUnpaid > 0)
{
    <div class="alert @(totalUnpaid > 100 ? "alert-danger" : "alert-warning")">
        You have <strong>@totalUnpaid.ToString("0.00") EGP</strong> in unpaid fines.
        @if (totalUnpaid > 100)
        {
            <text> Your account is currently blocked from new borrow requests until this is paid.</text>
        }
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table">
    <thead>
        <tr>
            <th>Book</th>
            <th>Status</th>
            <th>Due Date</th>
            <th>Fine</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var loan in Model)
        {
            <tr>
                <td>@loan.BookCopy?.Book?.Title</td>
                <td>@loan.Status</td>
                <td>@(loan.DueDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                <td>
                    @{
                        decimal fineAmount = 0;

                        // لو Fine record موجود واتدفعت، اعرض المبلغ المدفوع
                        if (loan.Fines != null)
                        {
                            fineAmount = loan.Fines.Amount;
                            <text>@fineAmount.ToString("0.00") EGP @(loan.Fines.IsPaid ? "(Paid)" : "(Unpaid)")</text>
                        }
                        // لو الكتاب لسه متأخر (Active أو ReturnRequested)، احسبها ديناميكي
                        else if ((loan.Status == ITI_Project.Model.LoanStatus.Active ||
                                 loan.Status == ITI_Project.Model.LoanStatus.ReturnRequested) &&
                                 loan.DueDate.HasValue &&
                                 DateTime.Now.Date > loan.DueDate.Value.Date)
                        {
                            var daysLate = (DateTime.Now.Date - loan.DueDate.Value.Date).Days;
                            fineAmount = daysLate * 5; // 5 جنيه/يوم
                                                       <text>@fineAmount.ToString("0.00") EGP (Current)</text>
                        }
                        // لو ما في غرامة
                        else if (fineAmount == 0)
                        {
                            <text>-</text>
                        }
                    }
                </td>
                <td>
                    @if (loan.Status == ITI_Project.Model.LoanStatus.Requested)
                    {
                        <form asp-action="CancelBorrowRequest" asp-controller="Loan" method="post"
                              onsubmit="return confirm('Cancel this borrow request?');">
                            <input type="hidden" name="loanId" value="@loan.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancel Request</button>
                        </form>
                    }
                    @if (loan.Status == ITI_Project.Model.LoanStatus.Active)
                    {
                        <form asp-action="RequestReturn" asp-controller="Loan" method="post">
                            <input type="hidden" name="loanId" value="@loan.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Request Return</button>
                        </form>
                    }
                    @if (loan.Status == ITI_Project.Model.LoanStatus.ReturnRequested)
                    {
                        <form asp-action="CancelReturnRequest" asp-controller="Loan" method="post"
                              onsubmit="return confirm('Cancel this return request?');">
                            <input type="hidden" name="loanId" value="@loan.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancel Return</button>
                        </form>
                    }
                    @if (loan.Status == ITI_Project.Model.LoanStatus.Rejected && !string.IsNullOrEmpty(loan.RejectionReason))
                    {
                        <span class="text-muted">Reason: @loan.RejectionReason</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
