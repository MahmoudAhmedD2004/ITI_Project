@model List<ITI_Project.Model.Loan>
@{
    ViewData["Title"] = "Pending Returns";
    Layout = "_MyLayout";
}

<h2>Pending Returns</h2>

<form asp-action="PendingReturns" method="get" class="filters-bar">
    <div class="filter-group" style="flex:1; min-width:220px;">
        <label>Search</label>
<div class="parent-input-box-search">
            <i class="bi bi-search icon-box-search"></i>
            <input type="text" name="q" value="@ViewBag.Search" placeholder="Search by member or book..." class="input-box-search" />
        </div>    </div>
    <div class="filter-group sort-group">
        <label>Sort by</label>
        <select name="sortBy" onchange="this.form.submit()">
            <option value="due_asc" selected="@(ViewBag.SortBy == "due_asc")">Due date (earliest)</option>
            <option value="due_desc" selected="@(ViewBag.SortBy == "due_desc")">Due date (latest)</option>
        </select>
        <button type="submit" class="btn btn-oak btn-sm">Apply</button>
        <a asp-action="PendingReturns" class="btn btn-ghost btn-sm">Reset</a>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Member</th>
            <th>Book</th>
            <th>Due Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var loan in Model)
        {
            var isLate = DateTime.Now > loan.DueDate;
            <tr class="@(isLate ? "table-danger" : "")">
                <td>@loan.Member?.UserName</td>
                <td>@loan.BookCopy?.Book?.Title</td>
                <td>@loan.DueDate?.ToString("yyyy-MM-dd") @(isLate ? "(late)" : "")</td>
                <td>
                    <form asp-action="ConfirmReturn" asp-controller="Loan" method="post"
                          onsubmit="return confirm('Confirm this book was returned?');">
                        <input type="hidden" name="loanId" value="@loan.Id" />
                        <button type="submit" class="btn btn-sm btn-primary">Confirm Return</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>