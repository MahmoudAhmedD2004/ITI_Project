@model ITI_Project.ModelView.ChangePasswordViewModel

<div class="page-head">
    <div>
        <h1>Change Password</h1>
        <p>Enter your current password to set a new one</p>
    </div>
</div>


@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="margin-bottom:16px;">@TempData["Error"]</div>
}

<div class="panel" style="padding:24px; max-width:480px;">
    <form asp-action="ChangePassword" method="post">
        <div asp-validation-summary="All" class="text-danger" style="margin-bottom:16px;"></div>

        <div class="field">
            <label>Current password</label>
            <input asp-for="CurrentPassword" type="password" />
            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
        </div>
        <div class="field">
            <label>New password</label>
            <input asp-for="NewPassword" type="password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>
        <div class="field">
            <label>Confirm new password</label>
            <input asp-for="ConfirmPassword" type="password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <div style="margin-top:20px; display:flex; gap:10px;">
            <button type="submit" class="btn btn-oak">Update password</button>
            <a asp-action="Profile" class="btn btn-ghost">Cancel</a>
        </div>
    </form>
</div>