@model ITI_Project.ModelView.EditProfileViewModel

<div class="page-head">
    <div>
        <h1>Edit Profile</h1>
        <p>Update your contact details</p>
    </div>
</div>

<div class="panel" style="padding:24px; max-width:480px;">
    <form asp-action="EditProfile" method="post">
        <div asp-validation-summary="All" class="text-danger" style="margin-bottom:16px;"></div>

        <div class="field">
            <label>Username</label>
            <input value="@User.Identity!.Name" disabled />
        </div>
        <div class="field">
            <label>Email</label>
            <input asp-for="Email" type="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="field">
            <label>Phone number</label>
            <input asp-for="PhoneNumber" type="tel" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>

        <div style="margin-top:20px; display:flex; gap:10px;">
            <button type="submit" class="btn btn-oak">Save changes</button>
            <a asp-action="Profile" class="btn btn-ghost">Cancel</a>
        </div>
    </form>
</div>