<!-- ---- Auth (Login / Sign up) ---- -->

<section class="page" id="page-auth">
    <div class="auth-wrap">
        <div class="auth-brand">
            <div>
                <span class="brand-mark" style="font-size:26px;">Folio</span>
            </div>
            <div>
                <h2>A library is a record of what a place decided was worth keeping.</h2>
                <div class="quote-attr">— from the front desk</div>
            </div>
        </div>

        <div class="auth-right">
            <div class="auth-card">
                <div class="auth-tabs">
                    <button class="auth-tab active" onclick="showAuthForm('login')">Sign in</button>
                    <button class="auth-tab" onclick="showAuthForm('signup')">Sign up</button>
                </div>

                <form asp-action="login" asp-controller="Member" method="post" class="auth-form active" id="form-login" >
                    <div class="field"><label>User Name</label><input type="text" name="username" placeholder="mahmoud12" /></div>
                    <div class="field"><label>Password</label><input type="password" name="password" placeholder="••••••••" /></div>
                    <button class="btn btn-oak auth-submit" type="submit">Sign in</button>
                    <div class="auth-foot">New here? <a onclick="showAuthForm('signup')">Create an account</a></div>
                </form>

                <form asp-action="Signup" asp-controller="Member" method="post" class="auth-form" id="form-signup">
                    <div class="field"><label>Username</label><input name="username" type="text" placeholder="yourname" /></div>
                    <div class="field"><label >Email</label><input name="email" type="email" placeholder="you@mail.com" /></div>
                    <div class="field"><label>Phone number</label><input name="phone" type="tel" placeholder="01xxxxxxxxx" /></div>
                    <div class="field"><label>Password</label><input name="passwod" type="password" placeholder="••••••••" /></div>
                    <button class="btn btn-oak auth-submit" type="submit">Create account</button>
                    <div class="auth-foot">Already a member? <a onclick="showAuthForm('login')">Sign in</a></div>
                </form>
            </div>
        </div>
    </div>
</section>