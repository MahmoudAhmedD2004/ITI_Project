@model IEnumerable<ITI_Project.ModelView.MemberViewModel>

@{
    ViewData["Title"] = "Members Administration";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="member-admin-add">

    <h2>Members Administration</h2>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-oak">+ Add New User</a>
    }
    </div>
</div>

<form asp-action="Index" method="get" class="filters-bar">
    <div class="filter-group" style="flex:1; min-width:220px;">
           <label>Search</label>
       <div class="parent-input-box-search">
            <i class="bi bi-search icon-box-search"></i>
            <input type="text" name="q" value="@ViewBag.Search" placeholder="Search by username or email..." class="input-box-search" />
        </div>
            
    
    </div>
    <div class="filter-group">
        <label>Role</label>
        <select name="role" onchange="this.form.submit()">
            <option value="">All roles</option>
            <option value="Member" selected="@(ViewBag.RoleFilter?.ToString() == "Member")">Member</option>
            <option value="Librarian" selected="@(ViewBag.RoleFilter?.ToString() == "Librarian")">Librarian</option>
            <option value="Admin" selected="@(ViewBag.RoleFilter?.ToString() == "Admin")">Admin</option>
        </select>
    </div>
    <div class="filter-group">
        <label>Status</label>
        <select name="blocked" onchange="this.form.submit()">
            <option value="">All</option>
            <option value="false" selected="@(ViewBag.BlockedFilter == false)">Active</option>
            <option value="true" selected="@(ViewBag.BlockedFilter == true)">Blocked</option>
        </select>
    </div>
    <div class="filter-group sort-group">
        <label>Sort by</label>
        <select name="sortBy" onchange="this.form.submit()">
            <option value="name_asc" selected="@(ViewBag.SortBy == "name_asc")">Name (A-Z)</option>
            <option value="name_desc" selected="@(ViewBag.SortBy == "name_desc")">Name (Z-A)</option>
            <option value="expiry_asc" selected="@(ViewBag.SortBy == "expiry_asc")">Expiry (soonest)</option>
            <option value="expiry_desc" selected="@(ViewBag.SortBy == "expiry_desc")">Expiry (latest)</option>
            <option value="loans_desc" selected="@(ViewBag.SortBy == "loans_desc")">Most active loans</option>
        </select>
        <button type="submit" class="btn btn-oak btn-sm">Apply</button>
        <a asp-action="Index" class="btn btn-ghost btn-sm">Reset</a>
    </div>
</form>

<div class="card card-body border-0 shadow table-wrapper table-responsive">
    <table class="table table-hover align-items-center">
        <thead>
            <tr>
                <th class="border-gray-200">#</th>
                <th class="border-gray-200">Member Name</th>
                <th class="border-gray-200">Email</th>
                <th class="border-gray-200">Role</th>
                <th class="border-gray-200">Membership Expiry</th>
                <th class="border-gray-200">Active Loans</th>
                <th class="border-gray-200">Status</th>
                <th class="border-gray-200">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in Model)
            {
                <tr>
                    <td>@member.Id</td>
                    <td class="fw-bold">@member.UserName</td>
                    <td>@member.Email</td>
                    <td>@member.Role</td>
                    <td>@member.MembershipExpiryDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        <span class="badge bg-info">@member.ActiveLoansCount Books</span>
                    </td>
                    <td>
                        @if (member.IsBlocked)
                        {
                            <span class="badge bg-danger">Blocked</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Active</span>
                        }
                    </td>
                    <td>
                        <div >

                        <a class="view-loans-res" asp-action="Details" asp-controller="Members" asp-route-id="@member.Id" >
                        View Member Details
                        </a>
                        </div>
                        <div class="edit-and-delete">
                        
                                
                            @if (User.IsInRole("Admin"))
                            {

                                <a class="edit-member" asp-action="Edit" asp-route-id="@member.Id" >Edit</a>
                            }
                                
                            
                            <form asp-action="ToggleBlock" asp-route-id="@member.Id" method="post" class="d-inline">
                                @if (member.IsBlocked)
                                {
                                    <button class="unblock-member" type="submit" class="btn btn-sm btn-success">Unblock</button>
                                }
                                else
                                {
                                    
                                    <button  class="block-member" onclick="return confirm('Are you sure you want to block this member?');">Block</button>

                                    
                                }
                            </form>
                        </div>
                         
                    </td>
                   </tr>
                
            }
        </tbody>
    </table>
    @if ((int)ViewBag.TotalPages > 1)
    {
        <nav style="margin-top: 24px; display:flex; gap:6px; justify-content:center; flex-wrap: wrap;">
            @for (int p = 1; p <= (int)ViewBag.TotalPages; p++)
            {
                <a asp-action="Index"
                   asp-route-page="@p"
                   asp-route-q="@ViewBag.Search"
                   asp-route-role="@ViewBag.RoleFilter"
                   asp-route-blocked="@ViewBag.BlockedFilter"
                   asp-route-sortBy="@ViewBag.SortBy"
                   class="btn btn-sm @(p == (int)ViewBag.CurrentPage ? "btn-oak" : "btn-ghost")">
                    @p
                </a>
            }
        </nav>
    }
</div>