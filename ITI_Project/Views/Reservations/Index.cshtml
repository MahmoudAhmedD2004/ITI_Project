@model IEnumerable<ITI_Project.ModelView.ReservationViewModel>

@{
    ViewData["Title"] = "Reservations & Waiting List";
}


@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card card-body border-0 shadow table-wrapper table-responsive">
    <table class="table table-hover align-items-center">
        <thead>
            <tr>
                <th class="border-gray-200">#</th>
                <th class="border-gray-200">Book Title</th>
                <th class="border-gray-200">Member Name</th>
                <th class="border-gray-200">Reservation Date</th>
                <th class="border-gray-200">Queue Position</th>
                <th class="border-gray-200">Status</th>
                <th class="border-gray-200">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No reservations found.</td>
                </tr>
            }
            else
            {
                @foreach (var res in Model)
                {
                    <tr>
                        <td class="fw-bold">@res.Id</td>
                        <td class="fw-bold text-dark">@res.BookTitle</td>
                        <td>
                            <span class="fw-normal">@res.MemberName</span><br />
                            <small class="text-muted">@res.MemberEmail</small>
                        </td>
                        <td>@res.ReservationDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (string.Equals(res.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-info text-dark">#@res.QueuePosition in line</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (string.Equals(res.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else if (string.Equals(res.Status, "Fulfilled", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-success">Fulfilled</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Cancelled</span>
                            }
                        </td>
                        <td>
                            @if (string.Equals(res.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                            {
                                <form asp-action="Cancel" asp-route-id="@res.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to cancel this reservation?');">
                                        Cancel
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    @if ((int?)ViewBag.TotalPages > 1)
    {
        <nav style="display:flex; gap:4px; margin-top:12px;">
            @for (int p = 1; p <= (int)ViewBag.TotalPages; p++)
            {
                <a asp-action="Index" asp-route-page="@p"
                   class="btn btn-sm @(p == (int)ViewBag.CurrentPage ? "btn-oak" : "btn-ghost")">
                    @p
                </a>
            }
        </nav>
    }
</div>
