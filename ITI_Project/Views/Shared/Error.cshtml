@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
    Layout = "_MyLayout";
}

<div class="error-page">
    <h1>Something went wrong</h1>
    <p>We hit an unexpected error while processing your request. It's not you — it's us.</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted"><small>Reference: <code>@Model.RequestId</code></small></p>
    }

    <a asp-controller="Book" asp-action="Index" class="btn btn-oak">Back to Home</a>
</div>