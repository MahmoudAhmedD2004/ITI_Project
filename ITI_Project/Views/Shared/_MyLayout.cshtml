<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Folio — Library Management</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/Book.css" />
    <link rel="stylesheet" href="~/css/Member.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body>

  <!-- ================= SIDEBAR ================= -->
  <nav class="sidebar">
    <div class="brand">
      <span class="brand-mark">Folio</span>
      <span class="brand-sub">Library</span>
    </div>

    <div class="nav-group">
      <div class="nav-label">Overview</div>
      <a class="nav-item active" asp-controller="Book" asp-action="Index">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
        Dashboard
      </a>

      <div class="nav-label">Catalog</div>
      <a class="nav-item" data-page="books" asp-controller="Book" asp-action="BookView">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        Books
      </a>

       <a class="nav-item" data-page="authors" asp-controller="Authors" asp-action="Index">  <!-- Authors-->
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
        Authors
      </a>

      <a class="nav-item" data-page="categories" asp-controller="Categories" asp-action="Index">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.6 12.6 12.6 20.6a2 2 0 0 1-2.8 0L2 12.8V3h9.8l8.8 8.8a2 2 0 0 1 0 2.8Z"/><circle cx="7" cy="7.5" r="1.2" fill="currentColor" stroke="none"/></svg>
        Categories
      </a>
            @if (@User.IsInRole("Librarian") || @User.IsInRole("Admin"))
                {
                    <div class="nav-label">People</div>
                    <a class="nav-item" data-page="members" asp-controller="Members" asp-action="Index"> 
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        Members
                    </a>
                }
      <div class="nav-label">Circulation</div>
@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    @if (User.IsInRole("Librarian") || User.IsInRole("Admin"))
    {
        <a class="nav-item" asp-controller="Loan" asp-action="PendingRequests">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 2 21 6l-4 4" /><path d="M3 12v-1a4 4 0 0 1 4-4h14" /><path d="M7 22 3 18l4-4" /><path d="M21 12v1a4 4 0 0 1-4 4H3" /></svg>
            Borrow Requests
        </a>
        <a class="nav-item" asp-controller="Loan" asp-action="PendingReturns">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 2 21 6l-4 4" /><path d="M3 12v-1a4 4 0 0 1 4-4h14" /><path d="M7 22 3 18l4-4" /><path d="M21 12v1a4 4 0 0 1-4 4H3" /></svg>
            Pending Returns
        </a>
        <a class="nav-item" asp-controller="Loan" asp-action="AllLoans">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            All Loans
        </a>
    }
    else
    {
        <a class="nav-item" asp-controller="Loan" asp-action="MyLoans">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 2 21 6l-4 4" /><path d="M3 12v-1a4 4 0 0 1 4-4h14" /><path d="M7 22 3 18l4-4" /><path d="M21 12v1a4 4 0 0 1-4 4H3" /></svg>
            My Loans
        </a>
    }
        }
        @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a class="nav-item" data-page="reservations" asp-controller="Reservations" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M19 21 12 16.5 5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                        Reservations
                    </a>
                }
                @if (User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Librarian") || User.IsInRole("Admin")))
        {
            <a class="nav-item" asp-controller="Loan" asp-action="AllFines">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M12 7v10M9.5 9.5c0-1.4 1.1-2.3 2.5-2.3s2.5.8 2.5 2c0 2.5-5 1.6-5 4.1 0 1.2 1.1 2.2 2.5 2.2s2.5-.9 2.5-2.3" /></svg>
                Fines
            </a>
        }

        <a class="nav-item" asp-controller="Book" asp-action="Report">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M3 3v18h18" />
                <rect x="7" y="12" width="3" height="6" />
                <rect x="12" y="8" width="3" height="10" />
                <rect x="17" y="5" width="3" height="13" />
            </svg>
            Reports
        </a>

            <!-- edit -->
            <!-- 🟢 إضافة رابط الشات هنا -->
            <a class="nav-item" asp-controller="Chat" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>
                Chat Bot
            </a>

            @if (User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Librarian") || User.IsInRole("Admin")))
            {
                <a class="nav-item" asp-controller="Loan" asp-action="AllFines">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M12 7v10M9.5 9.5c0-1.4 1.1-2.3 2.5-2.3s2.5.8 2.5 2c0 2.5-5 1.6-5 4.1 0 1.2 1.1 2.2 2.5 2.2s2.5-.9 2.5-2.3" /></svg>
                    Fines
                </a>
            }
           <!-- ===================== -->
        </div>

    <div class="sidebar-foot">
            @if (User.Identity!=null && User.Identity.IsAuthenticated)
            {
                <a asp-controller="Member" asp-action="Profile" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <circle cx="12" cy="8" r="4" />
                        <path d="M4 20c0-4 3.5-7 8-7s8 3 8 7" />
                    </svg>
                    @User.Identity.Name
                </a>
            }
            else
            {
                <a class="nav-item" data-page="auth" asp-action="Index" asp-controller="Member">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="M10 17l5-5-5-5"/><path d="M15 12H3"/></svg>
                Sign in / Sign up
                </a>
            }
    </div>
  </nav>

  <!-- ================= MAIN ================= -->
  <main class="main">
        @RenderBody()
  </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

    <script>
            $(document).ready(function() {
                $.validator.setDefaults({
                    onfocusout: function(element) {
                        $(element).valid();
                    }
                });
            });
    </script>

    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
